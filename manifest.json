{
  "manifest_version": 3,
  "name": "Translations & Citations for Gospel Library",
  "version": "1.3.0",
  "description": "Compare Bible translations and see which General Conference talks, Journal of Discourses sermons, and Joseph Smith teachings cite each verse — in a side panel that blends into the Gospel Library reader.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.scripture.api.bible/*",
    "https://bible-api.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.churchofjesuschrist.org/study/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/books.js",
        "src/content/sanitize.js",
        "src/content/theme.js",
        "src/content/detect.js",
        "src/content/panel.js",
        "src/citations/cit-data.js",
        "src/citations/highlights.js",
        "src/citations/talk-view.js",
        "src/citations/cit-panel.js",
        "src/content/content.js"
      ],
      "css": ["src/content/panel.css", "src/citations/citations.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/citations/data/*", "src/content/page-hook.js"],
      "matches": ["https://www.churchofjesuschrist.org/*"]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Toggle Translations & Citations panel"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
